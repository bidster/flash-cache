{
  "name": "@bidster/flash-cache",
  "version": "1.0.0-rc.11",
  "description": "Ultra-fast two-level cache (L1/L2) with stale-while-revalidate mechanism for Node.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bidster/flash-cache.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs/flash-cache.md",
    "LICENSE",
    "README.ru.md"
  ],
  "scripts": {
    "build": "yarn clean && yarn build:esm && yarn build:cjs",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "clean": "rm -rf dist",
    "test": "vitest run --exclude \"src/**/*.integration.spec.ts\"",
    "test:integration": "DOCKER_HOST=unix://$HOME/.docker/run/docker.sock vitest run src/stores/ioredis-store.integration.spec.ts",
    "test:types": "yarn build && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cache",
    "flash-cache",
    "bidster",
    "stale-while-revalidate",
    "nodejs",
    "redis"
  ],
  "author": "Bidster Team <tech@bidster.net>",
  "license": "MIT",
  "peerDependencies": {
    "ioredis": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "ioredis": "^5.8.1",
    "prettier": "3.9.10",
    "testcontainers": "^11.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
