{
  "name": "@bidster/flash-cache-comparison",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "bench": "npm run bench:cache && npm run bench:get-or-set && npm run bench:overhead",
    "bench:cache": "node comparison.bench.mjs",
    "bench:get-or-set": "node get-or-set.bench.mjs",
    "bench:cpu": "node cpu-get-or-set.bench.mjs",
    "bench:get-or-set-cacheable": "node get-or-set-cacheable.bench.mjs",
    "bench:overhead": "node overhead.bench.mjs",
    "bench:flash-cache": "node --expose-gc flash-cache.bench.mjs"
  },
  "dependencies": {
    "cache-manager": "7.2.9",
    "cacheable": "2.5.0",
    "keyv": "5.6.0",
    "lru-cache": "11.5.3",
    "tinybench": "5.1.0"
  }
}
